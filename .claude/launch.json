{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--directory",
        "web"
      ],
      "port": 8765
    },
    {
      "name": "web-main",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8766",
        "--directory",
        "web"
      ],
      "port": 8766
    },
    {
      "name": "api-main",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "INVEST_CORS_ORIGINS=http://localhost:8766",
        "go",
        "-C",
        "api",
        "run",
        "./cmd/api",
        "-addr",
        ":8081",
        "-data",
        "../web/fixtures/invest"
      ],
      "port": 8081
    }
  ]
}
